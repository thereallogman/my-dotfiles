{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	"type": "small",
	"padding": {
		"top": 2
	}
  },
  "display": {
  	"disableLinewrap" : true
  },
    "modules": [
    "title",
    "separator",
    "os",
    {
	    "key": "OS Age",
	    "type": "disk",
	    "folders": "/",
	    "format": "{days} days"
    },
    "wm",
    "cpu",
    "gpu",
    "memory",
    "disk",
    {
	    "type": "custom",
	    "format": "{#keys}larp"
    }
  ]
}
